  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.65.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",

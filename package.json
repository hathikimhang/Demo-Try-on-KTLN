    "test:dynamic": "node scripts/verify-dynamic-fit.mjs",
    "test:session": "node scripts/verify-session-fit.mjs",
    "test:upload": "node scripts/verify-upload-fit.mjs",
    "test:upload-measurement": "node scripts/verify-upload-measurement.mjs",
    "test:3d-recovery": "node scripts/verify-3d-recovery.mjs",
